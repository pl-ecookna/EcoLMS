{
  "name": "ecolms",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build && pnpm --dir apps/api build",
    "lint": "pnpm --dir apps/web lint",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:ui": "sh ./scripts/dev-ui.sh",
    "build:api": "pnpm --dir apps/api build",
    "dev:worker": "uv run --project apps/worker ecolms-worker",
    "dev:transcription": "python3 apps/transcription-service/src/transcription_service/main.py",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "dev:infra:up": "docker compose -f docker-compose.ui-infra.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.ui-infra.yml down -v"
  }
}
